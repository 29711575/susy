#!/bin/bash
#PBS -N kitaev_l4_array
#PBS -q workq
#PBS -l nodes=1:ppn=1
#PBS -l walltime=04:00:00
#PBS -J 1-4
#PBS -j oe
export LC_ALL=C LANG=C
set -eo pipefail
cd "${PBS_O_WORKDIR:?}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_DYNAMIC=FALSE
seeds=(8001 8002 8003 8004)
index=$((PBS_ARRAY_INDEX-1))
test "$index" -ge 0
test "$index" -lt "${#seeds[@]}"
seed=${seeds[$index]}
trap 'code=$?; printf "%s\n" "$code" > "job_exit_${seed}.txt"' EXIT
binary=/home/sunxr/kitaev_weight_opt_p20022_20260916/mc_default
expected=739a282c06c7ea9071ac5ccfd44ff9120041d826849d6805982170252064881e
actual=$(sha256sum "$binary")
test "${actual%% *}" = "$expected"
printf 'array_index=%s seed=%s hostname=%s binary_sha256=%s\n' \
  "$PBS_ARRAY_INDEX" "$seed" "$(hostname)" "${actual%% *}"
mkdir -p results
"$binary" --Lx 4 --Ly 4 --Jx 1 --Jy 1 --Jz .5 --g .3 --mass 1.7 --omega-ph .8 \
  --trial-dx .1378676470588235 --trial-dy .1378676470588235 --trial-dz .1378676470588235 \
  --intervals 64 --dt .1 --proposal bond-refresh --weight-engine combined --seed "$seed" \
  --warmup 3200 --sweeps 1600 --measure-every 1 --block-samples 25 --qr-block 4 --vbs 1 \
  --output "results/l4_${seed}" > "results/l4_${seed}_stdout.log" 2> "results/l4_${seed}_stderr.log"
date -Is
