#!/bin/bash
#PBS -N kitaev_T64_pilot
#PBS -q workq
#PBS -l nodes=1:ppn=2
#PBS -l walltime=00:15:00
#PBS -j oe
source /opt/ohpc/pub/apps/intel/oneapi/setvars.sh >/dev/null 2>&1
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
trap 'code=$?; printf "%s\n" "$code" > job_exit.txt' EXIT
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_DYNAMIC=FALSE
reference=/home/sunxr/kitaev_ssh_project_smoke_v2.AEKaLn
export P5_BINARY="$reference/mc_smoke" P5_OUTPUT_DIR="$PWD/results"
mkdir -p results
hostname
date -Is
sha256sum "$P5_BINARY"
icpc -O3 -std=c++17 -mkl=sequential -DPFQMC_SCALE_SAFE_UDT \
  -fp-model=precise -fimf-arch-consistency=true -no-fma \
  -I"$reference/inc" -I"$reference/kitaev_ssh" \
  -I/home/sunxr/software/eigen-3.4.0 -I/home/sunxr/boost_1_70_0 \
  kitaev_ssh/free_projector.cpp "$reference/src/skewMatUtils.cpp" \
  /home/sunxr/new-pfqmc-main/inc/pfapack/c_interface/libcpfapack.a \
  /home/sunxr/new-pfqmc-main/inc/pfapack/fortran/libpfapack.a \
  -o free_diagnostic > free_build.log 2>&1
./free_diagnostic --Lx 2 --Ly 2 --Jx 1 --Jy 1 --Jz .5 --theta .4 --dt .2 --block 4 > results/free_diagnostic.json
/opt/ohpc/pub/apps/anaconda3/bin/python - <<'PY'
import json
d=json.load(open('results/free_diagnostic.json'))
assert abs(d['energy_total']+5)<1e-12
assert d['trial_to_projected_green_max_error']<1e-12
assert max(abs(complex(*b)+.5) for b in d['trial_bond_mean'])<1e-12
print('ACTUAL_FREE_TRIAL_CHECK_PASS')
PY
bash kitaev_ssh/run_p5.sh followup_a & chain_a=$!
bash kitaev_ssh/run_p5.sh followup_b & chain_b=$!
status_a=0; wait "$chain_a" || status_a=$?
status_b=0; wait "$chain_b" || status_b=$?
printf 'chain_exit_status %s %s\n' "$status_a" "$status_b"
date -Is
test "$status_a" -eq 0 && test "$status_b" -eq 0
