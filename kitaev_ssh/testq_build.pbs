#!/bin/bash
#PBS -N qmc_opt_build
#PBS -q testq
#PBS -l nodes=1:ppn=8
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m n
set -euo pipefail
export LC_ALL=C LANG=C
# Intel oneAPI's env scripts reference optional shell variables under nounset.
set +u
source /opt/ohpc/pub/apps/intel/oneapi/setvars.sh >/dev/null 2>&1
set -u
cd "${PBS_O_WORKDIR:?}"
mkdir -p bin build_logs results

CXX=${CXX:-icpc}
COMMON=(
  -O3 -std=c++17 -DPFQMC_SCALE_SAFE_UDT
  -mkl=sequential -fp-model=precise -fimf-arch-consistency=true -no-fma
  -Iinc -I/home/sunxr/software/eigen-3.4.0 -I/home/sunxr/boost_1_70_0
)
PF_LIBS=(
  /home/sunxr/new-pfqmc-main/inc/pfapack/c_interface/libcpfapack.a
  /home/sunxr/new-pfqmc-main/inc/pfapack/fortran/libpfapack.a
)

compile_one() {
  local source=$1
  local name=$2
  "$CXX" "${COMMON[@]}" "$source" src/skewMatUtils.cpp "${PF_LIBS[@]}" -o "bin/$name" \
    >"build_logs/$name.log" 2>&1
}

specs=(
  "kitaev_ssh/coupled_mc.cpp:kitaev_ssh_mc"
  "kitaev_ssh/fermion_validate.cpp:kitaev_ssh_fermion_validate"
  "kitaev_ssh/weight_optimization_validate.cpp:kitaev_ssh_weight_validate"
  "kitaev_ssh/a3_generator_validate.cpp:kitaev_ssh_a3_validate"
  "kitaev_ssh/deferred_phase_validate.cpp:kitaev_ssh_deferred_phase_validate"
  "kitaev_ssh/validate.cpp:kitaev_ssh_validate"
  "kitaev_ssh/phonon_validate.cpp:kitaev_ssh_phonon_validate"
  "kitaev_ssh/mc_validate.cpp:kitaev_ssh_mc_validate"
  "kitaev_ssh/shifted_trial_validate.cpp:kitaev_ssh_shifted_validate"
  "kitaev_ssh/vbs_validate.cpp:kitaev_ssh_vbs_validate"
  "kitaev_ssh/vbs_q_validate.cpp:kitaev_ssh_vbs_q_validate"
)

hostname
date -Is
pids=()
for spec in "${specs[@]}"; do
  IFS=: read -r source name <<<"$spec"
  compile_one "$source" "$name" &
  pids+=("$!")
done
status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=$?
done
if ((status != 0)); then
  exit "$status"
fi

sha256sum bin/* > bin.sha256
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_DYNAMIC=FALSE
./bin/kitaev_ssh_fermion_validate >results/fermion_validate.stdout 2>results/fermion_validate.stderr
./bin/kitaev_ssh_weight_validate >results/weight_validate.stdout 2>results/weight_validate.stderr
./bin/kitaev_ssh_a3_validate >results/a3_validate.stdout 2>results/a3_validate.stderr
./bin/kitaev_ssh_deferred_phase_validate 7911 .3 64 12 \
  >results/deferred_phase_validate.stdout 2>results/deferred_phase_validate.stderr
./bin/kitaev_ssh_validate >results/validate.stdout 2>results/validate.stderr
./bin/kitaev_ssh_phonon_validate >results/phonon_validate.stdout 2>results/phonon_validate.stderr
./bin/kitaev_ssh_mc_validate >results/mc_validate.stdout 2>results/mc_validate.stderr
./bin/kitaev_ssh_shifted_validate >results/shifted_validate.stdout 2>results/shifted_validate.stderr
./bin/kitaev_ssh_vbs_validate >results/vbs_validate.stdout 2>results/vbs_validate.stderr
./bin/kitaev_ssh_vbs_q_validate >results/vbs_q_validate.stdout 2>results/vbs_q_validate.stderr
date -Is
