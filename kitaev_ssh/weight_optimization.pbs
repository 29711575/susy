#!/bin/bash
#PBS -N kitaev_weight_opt
#PBS -q workq
#PBS -l nodes=1:ppn=8
#PBS -l walltime=00:30:00
#PBS -j oe
export LC_ALL=C LANG=C
source /opt/ohpc/pub/apps/intel/oneapi/setvars.sh >/dev/null 2>&1
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
trap 'code=$?; printf "%s\n" "$code" > job_exit.txt' EXIT
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_DYNAMIC=FALSE
mkdir results
compile() {
 icpc -O3 -std=c++17 -mkl=sequential -DPFQMC_SCALE_SAFE_UDT \
  -fp-model=precise -fimf-arch-consistency=true -no-fma \
  -Iinc -I/home/sunxr/software/eigen-3.4.0 -I/home/sunxr/boost_1_70_0 \
  "$1" src/skewMatUtils.cpp \
  /home/sunxr/new-pfqmc-main/inc/pfapack/c_interface/libcpfapack.a \
  /home/sunxr/new-pfqmc-main/inc/pfapack/fortran/libpfapack.a -o "$2" ${3:-} > "$2.build.log" 2>&1
}
hostname; date -Is
pids=()
for spec in 'kitaev_ssh/weight_benchmark.cpp bench' 'kitaev_ssh/weight_benchmark.cpp bench_profile -DBENCH_PROFILE' \
 'kitaev_ssh/weight_optimization_validate.cpp replay' 'kitaev_ssh/phonon_validate.cpp p2' \
 'kitaev_ssh/mc_validate.cpp p3' 'kitaev_ssh/coupled_mc.cpp mc' \
 'reproduction/pure_state_driven_stage1/density_sign_regression.cpp density'; do
 compile $spec & pids+=("$!")
done
for pid in "${pids[@]}"; do wait "$pid"; done
./p2 > results/p2.log 2>&1
./p3 > results/p3.log 2>&1
./replay > results/replay.json 2>results/replay.stderr
./density reproduction/pure_state_driven_stage1/density_sign_fixtures > results/density.log 2>&1
# Two repetitions, each variant on the same node under matched concurrency.
# No per-operation clocks in these production-throughput runs.
for repeat in 1 2; do
 pids=()
 for mode in 0 1 2 3; do
  ./bench "$mode" > "results/bench_${repeat}_${mode}.json" 2>"results/bench_${repeat}_${mode}.stderr" & pids+=("$!")
 done
 for pid in "${pids[@]}"; do wait "$pid"; done
done
./bench_profile 3 > results/combined_profile.json 2>results/combined_profile.stderr
for engine in reference svd-values node-merge combined; do
 ./mc --Lx 2 --Ly 2 --Jz .5 --intervals 8 --dt .2 --proposal bond-refresh \
  --trial-dx .1378676470588235 --trial-dy .1378676470588235 --trial-dz .1378676470588235 \
  --weight-engine "$engine" --seed 7910 --warmup 2 --sweeps 8 --measure-every 1 --block-samples 2 --vbs 1 \
  --output "results/smoke_$engine" > "results/smoke_$engine.stdout" 2>"results/smoke_$engine.stderr"
done
sha256sum mc bench replay
date -Is
