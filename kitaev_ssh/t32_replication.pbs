#!/bin/bash
#PBS -N kitaev_t32_repl
#PBS -q workq
#PBS -l nodes=1:ppn=4
#PBS -l walltime=00:15:00
#PBS -j oe
source /opt/ohpc/pub/apps/intel/oneapi/setvars.sh >/dev/null 2>&1
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
trap 'code=$?; printf "%s\n" "$code" > job_exit.txt' EXIT
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_DYNAMIC=FALSE
binary=/home/sunxr/kitaev_shift_trial_20260916.1TSYvf/shifted_mc
expected=75440fcce5f9781c2f89eb776d78d4209cc46509b07cdf8def34727d1be2edf4
actual=$(sha256sum "$binary"); test "${actual%% *}" = "$expected"
hostname; date -Is; sha256sum "$binary"
mkdir -p results
run() {
 local label=$1 seed=$2 suffix
 for suffix in blocks.csv results.json stdout.log stderr.log; do
  test ! -e "results/${label}_$suffix" || { echo "Output exists: $label" >&2; return 2; }
 done
 "$binary" --Lx 2 --Ly 2 --Jx 1 --Jy 1 --Jz .5 --g .3 --mass 1.7 --omega-ph .8 \
  --trial-dx .1378676470588235 --trial-dy .1378676470588235 --trial-dz .1378676470588235 \
  --intervals 16 --dt .2 --proposal bond-refresh --seed "$seed" \
  --warmup 3200 --sweeps 8000 --measure-every 1 --block-samples 25 --qr-block 4 --vbs 1 \
  --output "results/$label" > "results/${label}_stdout.log" 2> "results/${label}_stderr.log"
}
run replication_a 7201 & a=$!
run replication_b 7202 & b=$!
run replication_c 7203 & c=$!
run replication_d 7204 & d=$!
code=0
for pid in "$a" "$b" "$c" "$d"; do
 status=0; wait "$pid" || status=$?
 printf 'chain exit %s\n' "$status"
 if [[ $status != 0 ]]; then code=$status; fi
done
date -Is
exit "$code"
