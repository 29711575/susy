#!/bin/bash
#PBS -N qmc_opt_long
#PBS -q testq
#PBS -l nodes=1:ppn=1
#PBS -l walltime=04:00:00
#PBS -J 1-4
#PBS -j oe
#PBS -m n
set -euo pipefail
export LC_ALL=C LANG=C
# Intel oneAPI's env scripts reference optional shell variables under nounset.
set +u
source /opt/ohpc/pub/apps/intel/oneapi/setvars.sh >/dev/null 2>&1
set -u
cd "${PBS_O_WORKDIR:?}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_DYNAMIC=FALSE

index=${PBS_ARRAY_INDEX:?}
case "$index" in
  1) engine=combined; g=.3; seed=8201; defer=0 ;;
  2) engine=combined; g=.3; seed=8201; defer=1 ;;
  3) engine=reference; g=.6; seed=8301; defer=0 ;;
  4) engine=reference; g=.6; seed=8301; defer=1 ;;
  *) echo "invalid PBS_ARRAY_INDEX=$index" >&2; exit 2 ;;
esac

mkdir -p results
prefix="$PBS_O_WORKDIR/results/long_${engine}_g${g}_seed${seed}_defer${defer}"
echo "hostname=$(hostname)"
echo "date=$(date -Is)"
echo "index=$index engine=$engine g=$g seed=$seed defer=$defer"

args=(
  --Lx 4 --Ly 4 --Jx 1 --Jy 1 --Jz .5 --intervals 64 --dt .1
  --mass 1.7 --omega-ph .8 --g "$g" --seed "$seed"
  --warmup 400 --sweeps 1600 --measure-every 2 --block-samples 40 --qr-block 4
  --proposal bond-refresh --weight-engine "$engine" --defer-phase "$defer"
  --fermions 1 --output "$prefix"
)

set +e
/usr/bin/time -f 'real_seconds=%e\nuser_seconds=%U\nsys_seconds=%S\nmax_rss_kb=%M' \
  -o "$prefix.time" ./bin/kitaev_ssh_mc "${args[@]}" \
  >"$prefix.stdout" 2>"$prefix.stderr"
status=$?
set -e
printf '%s\n' "$status" >"$prefix.exit"
echo "exit_code=$status"
echo "date=$(date -Is)"
exit "$status"
